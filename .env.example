# Copy to .env.local (never committed). Every variable is optional – the site runs without any of them.

# Public origin, used for canonical URLs, hreflang, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://glob3x.com

# Public URL of the Reeds Towers microsite (links from the Reeds pages). Default: http://localhost:3000
NEXT_PUBLIC_REEDS_URL=https://glob3x.com/reeds

# Contact form → company inbox. Hostinger Business Email: smtp.hostinger.com:465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@glob3x.com
SMTP_PASS=
# Defaults to SMTP_USER's domain inbox (site.email) when unset.
LEAD_TO=info@glob3x.com

# Where accepted leads are appended as NDJSON. Default: <project>/.leads
LEAD_LOG_DIR=

# Optional: where contact-form leads are also POSTed as JSON (CRM / Make / Zapier / n8n).
LEAD_WEBHOOK_URL=

# Search Console / Bing verification tokens (the value from the <meta> tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# npm run translate – DeepL key for the machine-translated extra locales (free keys end in ":fx").
DEEPL_API_KEY=
# Locales to generate (DeepL target codes, lower-case). Default: el,tr,nl,pt-br,pl,ru,uk,ar,zh-hans,ja,ko
EXTRA_LOCALES=

# npm run animate – Higgsfield API credentials for the generated project hero clips.
HF_API_KEY=
HF_API_SECRET=
