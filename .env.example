# Copy to .env.local (never committed). Every variable is optional – the site runs without any of them.

# Public origin of the group website; this app is served under it at /reeds.
NEXT_PUBLIC_GROUP_URL=https://glob3x.com

# Contact form → company inbox (Hostinger Business Email).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@glob3x.com
SMTP_PASS=
LEAD_TO=info@glob3x.com
# Where accepted leads are appended as NDJSON. Default: <project>/.leads
LEAD_LOG_DIR=
# Optional: where leads are also POSTed as JSON (CRM / Make / Zapier / n8n).
LEAD_WEBHOOK_URL=

# Google tag behind Consent Mode v2 and the Meta Pixel (lib/analytics.ts). Nothing loads and no cookie banner shows until one ID is set.
# Use the same values as glob3x-group-web: both apps share the glob3x.com origin and one consent choice.
# Google Ads tag ID (AW-…) and the conversion labels (the part after "/" in the event snippet).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADS_LEAD_LABEL=
NEXT_PUBLIC_ADS_WHATSAPP_LABEL=
# Optional GA4 measurement ID (G-…).
NEXT_PUBLIC_GA4_ID=
# Meta Pixel / dataset ID (Business Settings → Datasets & pixels). Loads only after "Accept".
NEXT_PUBLIC_META_PIXEL_ID=
