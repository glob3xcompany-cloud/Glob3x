# Copy to .env.local (never committed). Every variable is optional – the site runs without any of them.

# Public URL of the Reeds Towers microsite (links from the Reeds pages). Default: http://localhost:3000
NEXT_PUBLIC_REEDS_URL=https://reedstowers.al

# Where contact-form leads are POSTed as JSON. Without it, leads are written to .leads/ in development.
LEAD_WEBHOOK_URL=

# npm run translate – DeepL key for the machine-translated extra locales (free keys end in ":fx").
DEEPL_API_KEY=
# Locales to generate (DeepL target codes, lower-case). Default: el,tr,nl,pt-br,pl,ru,uk,ar,zh-hans,ja,ko
EXTRA_LOCALES=

# npm run animate – Higgsfield API credentials for the generated project hero clips.
HF_API_KEY=
HF_API_SECRET=
